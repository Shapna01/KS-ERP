generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model designations {
  id              Int     @id @default(autoincrement())
  name            String
  description     String?
  team_associated String?
  department      String?
  department_head String?
  users           users[]
}

model users {
  id                 Int           @id @default(autoincrement())
  password           String        @db.VarChar(255)
  name               String        @db.VarChar(255)
  designationId      Int?
  team               String        @db.VarChar(255)
  manager            String        @db.VarChar(255)
  role               String        @db.VarChar(255)
  phone              String        @db.VarChar(20)
  joining_date       DateTime?     @db.Date
  offer_letter       String
  increment_document String
  userid             String        @db.VarChar(255)
  workemail          String        @db.VarChar(255)
  personalemail      String        @db.VarChar(255)
  dob                DateTime      @db.Date
  gender             String        @db.VarChar(50)
  present_address    String
  permanent_address  String
  department         String        @db.VarChar(255)
  reporting_to       String        @db.VarChar(255)
  employment_type    String        @db.VarChar(255)
  aadhaar            String        @db.VarChar(50)
  pan                String        @db.VarChar(50)
  passport           String        @db.VarChar(50)
  designation        designations? @relation(fields: [designationId], references: [id])
}

model roles {
  id          Int      @id @default(autoincrement())
  role_name   String
  description String
  status      String
  total_users Int      @default(0)
  created_at  DateTime @default(now())
}

model Approval {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  module      String
  levels      Int
  status      String
  createdAt   DateTime @default(now())
}

model Project {
  id                 Int      @id @default(autoincrement())
  projectName        String
  projectDescription String
  projectCode        String
  projectManager     String
  estimatedBudget    Float
  approvalStatus     String
  teamSize           Int
  projectStatus      String
  createdAt          DateTime @default(now())
}

model PurchaseRequest {
  id               Int      @id @default(autoincrement())
  prNumber         String   @unique
  projectNumber    String
  department       String
  category         String
  priority         String
  requestType      String
  deliveryAddress  String?
  notes            String?
  status           String
  items            PurchaseRequestItem[]
  rfqs             RFQ[]
}

model PurchaseRequestItem {
  id                Int      @id @default(autoincrement())
  purchaseRequestId Int
  itemName          String
  itemCode          String
  quantity          Int
  estimatedRate     Float
  unit              String
  remarks           String?

  purchaseRequest PurchaseRequest
    @relation(fields:[purchaseRequestId], references:[id])
}

model Vendor {
  id          Int      @id @default(autoincrement())
  vendorName  String
  contactNo   String
  email       String
  gstNo       String?
  address     String?
}

model RFQ {
  id                Int      @id @default(autoincrement())
  rfqNumber         String   @unique
  purchaseRequestId Int
  dueDate           DateTime
  status            String

  purchaseRequest PurchaseRequest
    @relation(fields:[purchaseRequestId], references:[id])
}