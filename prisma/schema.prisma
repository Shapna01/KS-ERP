generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model designations {
  id              Int     @id @default(autoincrement())
  name            String
  description     String?
  team_associated String?
  department      String?
  department_head String?
  users           users[]
}

model users {
  id                 Int           @id @default(autoincrement())
  password           String        @db.VarChar(255)
  name               String        @db.VarChar(255)
  designationId      Int?
  team               String        @db.VarChar(255)
  manager            String        @db.VarChar(255)
  role               String        @db.VarChar(255)
  phone              String        @db.VarChar(20)
  joining_date       DateTime?     @db.Date
  offer_letter       String
  increment_document String
  userid             String        @db.VarChar(255)
  workemail          String        @db.VarChar(255)
  personalemail      String        @db.VarChar(255)
  dob                DateTime      @db.Date
  gender             String        @db.VarChar(50)
  present_address    String
  permanent_address  String
  department         String        @db.VarChar(255)
  reporting_to       String        @db.VarChar(255)
  employment_type    String        @db.VarChar(255)
  aadhaar            String        @db.VarChar(50)
  pan                String        @db.VarChar(50)
  passport           String        @db.VarChar(50)
  designation        designations? @relation(fields: [designationId], references: [id])
}

model roles {
  id          Int      @id @default(autoincrement())
  role_name   String
  description String
  status      String
  total_users Int      @default(0)
  created_at  DateTime @default(now())
}

model Approval {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  module      String
  levels      Int
  status      String
  createdAt   DateTime @default(now())
}

model Project {
  id Int @id @default(autoincrement())

  projectName        String
  projectCode        String
  projectDescription String?

  estimatedBudget Float?
  projectManager  String

  startDate DateTime?
  endDate   DateTime?

  approvalStatus String @default("Yet to Approve")

  projectStatus String @default("Pending")

  createdAt DateTime @default(now())
}



model ProductVendor {
  id Int @id @default(autoincrement())

  productId Int
  vendorId  Int

  product Product @relation(fields: [productId], references: [id])
  vendor  Vendor  @relation(fields: [vendorId], references: [id])

  @@unique([productId, vendorId])
}

model PurchaseRequisition {
  id                   Int       @id @default(autoincrement())
  prNumber             String    @unique
  projectNumber        String
  category             String
  priority             String
  deliveryAddress      String
  requestorDept        String
  expectedDeliveryDate DateTime?
  reason               String
  status               String    @default("Pending")
  createdAt            DateTime  @default(now())
}

model Product {
  id             Int      @id @default(autoincrement())
  productName    String
  productCode    String   @unique
  specification  String?
  estimatedPrice Float?

  createdAt      DateTime @default(now())
  productVendors ProductVendor[]
}

model Vendor {
  id Int @id @default(autoincrement())

  // Company Details
  vendorName      String
  establishedDate DateTime?
  panNumber       String?
  gstNumber       String?
  serviceCategory String?
  legalStructure  String?
  annualSales     String?
  msmeRegistered  String?
  address         String?

  // Contact Details
  contactName     String?
  contactNumber   String?
  contactEmail    String?
  fax             String?
  website         String?
  upiId           String?

  // Account Details
  beneficiaryName String?
  accountNumber   String?
  bankName        String?
  branchName      String?
  ifscCode        String?

  products ProductVendor[]

  createdAt DateTime @default(now())
}